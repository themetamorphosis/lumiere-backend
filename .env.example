ENVIRONMENT=development
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-64
DATABASE_URL=postgresql+asyncpg://lumiere:lumiere@localhost:5432/lumiere_db
TMDB_API_KEY=your_tmdb_api_key_here
UPLOAD_DIR=
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
# TRUSTED_PROXY_IPS=127.0.0.1  # comma-separated list of proxy IPs to trust for X-Forwarded-For

# Password recovery email. FRONTEND_URL is the public origin used in reset links.
# Leave SMTP_HOST and SMTP_FROM unset to disable delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
# Use false only for a local SMTP inbox.
SMTP_STARTTLS=true
